# Backend environment variables
# Copy this file to .env and fill in your actual values

PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://admin:admin@localhost:5432/conference_room_booking?schema=public"
# Required when NODE_ENV is not development. The process exits if this is unset in production.
# For local development only, an in-code placeholder is used when this is omitted.
# Never commit a real production secret.
JWT_SECRET=change-me-in-local-development
JWT_EXPIRES_IN=1d

# Redis — used by BullMQ for booking reminders. No credentials are hardcoded.
# The API process only enqueues/removes jobs. It does not consume them.
REDIS_URL=redis://127.0.0.1:6379
# Optional override for tests so they do not share the production queue name.
# REMINDER_QUEUE_NAME=booking-reminders

# Startup model:
#   Terminal 1 — API:    npm run dev --workspace backend
#   Terminal 2 — worker: npm run worker --workspace backend
# Do not start a second worker unless you intend multiple consumers.

# Email. When MAIL_HOST is empty (or NODE_ENV=test), Nodemailer uses jsonTransport.
# Set MAIL_HOST to enable SMTP. Never commit real passwords.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@conference.local
# Display timezone for email timestamps (IANA name). Independent of stored UTC.
MAIL_TIMEZONE=UTC

# Reminder lead time is NOT specified in the product PRD / email audit.
# This is an operational default: minutes before startTime. Override explicitly if needed.
# If a booking starts sooner than this window (but is still in the future), the job
# is queued with delay 0 so the worker can send as soon as it is running.
# Past startTimes are not scheduled.
REMINDER_LEAD_MINUTES=15

# Optional OpenAI constraint extraction for POST /api/ai/recommend.
# Leave OPENAI_API_KEY empty to use the deterministic fallback parser.
# User flow: natural language → extract constraints → user edits requirements
# → explicit Find rooms → backend validates and verifies availability
# → user selects a room → existing POST /api/bookings transaction.
# Recommendation results are not reservations. The LLM does not check
# availability or create bookings. Occupancy is always PENDING + CONFIRMED.
# Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000
# Optional compatible proxy. Leave empty for the default OpenAI endpoint.
# OPENAI_BASE_URL=
